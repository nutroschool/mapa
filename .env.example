# Variáveis públicas do aplicativo web
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Segredos exclusivos da Edge Function; configure no painel do Supabase.
# Nunca use NEXT_PUBLIC_ nestes valores.
META_INSTAGRAM_APP_ID=SUBSTITUA_AQUI
META_INSTAGRAM_APP_SECRET=SUBSTITUA_AQUI
INSTAGRAM_TOKEN_ENCRYPTION_KEY=CHAVE_BASE64_DE_32_BYTES
MAPA_APP_URL=https://SEU-DOMINIO
MAPA_ALLOWED_ORIGINS=https://SEU-DOMINIO,http://localhost:3000
INSTAGRAM_GRAPH_VERSION=v23.0

# Integração individual com Google Drive (somente Supabase Edge Functions)
GOOGLE_DRIVE_CLIENT_ID=SUBSTITUA_AQUI
GOOGLE_DRIVE_CLIENT_SECRET=SUBSTITUA_AQUI
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=CHAVE_BASE64_DE_32_BYTES
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://mapa.nutroschool.com.br/api/google-drive/callback
MAPA_CANONICAL_APP_URL=https://SEU-DOMINIO
